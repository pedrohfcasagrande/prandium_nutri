# Copiar para .env.prod (git-ignored) e preencher. Nenhum valor abaixo tem default seguro.
DOMAIN=app.prandiumnutri.com

# MySQL — gerar com: openssl rand -base64 24
DB_NAME=nutritracker
DB_USER=prandium
DB_PASS=
DB_ROOT_PASS=

# Seguranca — gerar com: openssl rand -base64 48
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=

# IA (chave NOVA — a antiga foi exposta no git e deve estar revogada)
AI_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

# Google Sign-In (adicionar https://DOMAIN nas Authorized JavaScript origins do client)
GOOGLE_CLIENT_ID=

# Pagamentos — chaves LIVE. Webhook URLs a registar nos dashboards:
#   Stripe:       https://DOMAIN/api/webhooks/stripe
#   Mercado Pago: https://DOMAIN/api/webhooks/mercado-pago
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Email (ex.: Resend, Brevo, Mailgun, Amazon SES)
MAIL_ENABLED=true
MAIL_FROM=no-reply@prandiumnutri.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Web Push — gerar com: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
