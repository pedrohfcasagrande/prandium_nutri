# --- IA para sugestoes de cardapio ---
# Escolha um provedor: "gemini" (grátis, recomendado) ou "openai" (pago)
AI_PROVIDER=gemini

# Se AI_PROVIDER=gemini, pegue em https://aistudio.google.com/apikey
GEMINI_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-latest

# Se AI_PROVIDER=openai, pegue em https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Google Sign-In (SSO) ---
GOOGLE_CLIENT_ID=2802497548-qhdcnqmobtiho7i7jlu4s8renrav8cef.apps.googleusercontent.com

# --- Seguranca ---
JWT_SECRET=troque-esse-segredo-por-uma-string-longa-e-aleatoria-com-pelo-menos-32-caracteres

# --- Admin seed ---
ADMIN_EMAIL=admin@admin.com
ADMIN_PASSWORD=admin@123

# --- Pagamentos ---
# Stripe (USD/EUR): https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=
# Assinatura de webhook (obtida com "stripe listen" no dev, ou dashboard em prod)
STRIPE_WEBHOOK_SECRET=

# Mercado Pago (BRL): https://www.mercadopago.com.br/developers/panel/app
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# URLs de redirecao apos checkout (em prod, use seu dominio real)
CHECKOUT_SUCCESS_URL=http://localhost:4201/billing?checkout=success
CHECKOUT_CANCEL_URL=http://localhost:4201/pricing?checkout=canceled
